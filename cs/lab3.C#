using System;

class Program
{
    static void Main()
    {
        double a = -4.0;
        double b = 4.0;
        double h = 0.5;
        int positiveCount = 0;

        Console.WriteLine("x\t\ty");

        for (double x = a; x <= b + 0.0000001; x = x + h)
        {
            double y;

            if (x <= 0)
            {
                y = x * x - 1;
            }
            else if (x <= 1.5)
            {
                y = Math.Cos(x);
            }
            else
            {
                y = Math.Sin(x - 1);
            }

            Console.WriteLine(x + "\t\t" + y);

            if (y > 0)
            {
                positiveCount = positiveCount + 1;
            }
        }

        Console.WriteLine();
        Console.WriteLine("Количество положительных значений: " + positiveCount);
    }
}